# =============================================================================
# BankApp — Local Development Environment Variables
# =============================================================================
# Copy this file to the appropriate location and adjust values as needed.
#
# Backend (Spring Boot):
#   Configuration lives in src/main/resources/application.yml.
#   No .env file is required — values below are for reference only.
#
# Frontend (React/Vite):
#   Copy the [Frontend] section into frontend/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Reference (configured in application.yml, not read from .env)
# -----------------------------------------------------------------------------
# SERVER_PORT=8989
# SERVER_CONTEXT_PATH=/bank-api
# SPRING_SECURITY_USER_NAME=bankapp
# SPRING_SECURITY_USER_PASSWORD=changeit
# SPRING_H2_CONSOLE_ENABLED=true
# SPRING_THREADS_VIRTUAL_ENABLED=true

# -----------------------------------------------------------------------------
# Frontend (place in frontend/.env)
# -----------------------------------------------------------------------------
# Base URL for the backend API. In development, Vite proxies this path to the
# backend server running on port 8989.
VITE_API_BASE_URL=/bank-api
